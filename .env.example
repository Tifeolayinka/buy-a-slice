# Copy to .env.local for development. Names only — never commit values.
# See docs/environments.md for where each value lives per environment.

# Neon Postgres — provisioned by the Vercel Marketplace integration;
# `vercel env pull .env.local --yes` fills this in.
DATABASE_URL=

# Site
NEXT_PUBLIC_SITE_URL=

# Paystack — TEST keys in dev/preview, LIVE keys only in production.
# The secret key is server-only. Never NEXT_PUBLIC_.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Moderation route/mutation protection
MODERATION_SECRET=

# Event selection (supports next-year reuse)
EVENT_SLUG=tife-2026
